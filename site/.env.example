# forgemesh.io site — environment variables
# Copy to .env.local for local work. EVERY variable is optional: `npm run build` and
# `npm run dev` succeed with none of them set. Each one only unlocks the feature named.

# Stripe checkout for the Kronos Field Guide and kit purchases. Without it the buy
# buttons render but checkout returns an error.
STRIPE_SECRET_KEY=

# Shared token the SES → SNS event receiver checks (/api/ses/events). Without it the
# route rejects every request, which is fine locally.
SES_EVENTS_TOKEN=

# GitHub token for the repo-watch and rules-watch cron scripts in site/scripts/.
# Raises the API rate limit; anonymous works for small runs.
GITHUB_TOKEN=

# OpenRouter key for the date-scan lookout script (site/scripts/date-scan.js).
OPENROUTER_API_KEY=

# Discord bot token used by the cron scripts to post into the brief channel.
DISCORD_BOT_TOKEN=

# Kodiak notification gateway (host:port) the scripts ping after a run.
KODIAK_NOTIFY_HOST=
KODIAK_NOTIFY_PORT=

# TikTok OAuth app credentials for the TikTok posting script.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
