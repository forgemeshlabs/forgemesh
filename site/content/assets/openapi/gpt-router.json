{
 "openapi": "3.1.0",
 "info": {
  "title": "ForgeMesh x402 Router (free routes)",
  "version": "1.0.0",
  "description": "Free discovery routes on the ForgeMesh x402 Router: the paid-tool menu with prices, the reputation leaderboard, and x402 Verified submission status."
 },
 "servers": [
  {
   "url": "https://router.forgemesh.io"
  }
 ],
 "paths": {
  "/menu": {
   "get": {
    "operationId": "paidToolMenu",
    "summary": "Every paid x402 route on the ForgeMesh fleet with its USDC price, host and method",
    "responses": {
     "200": {
      "description": "Menu",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       },
       "text/plain": {
        "schema": {
         "type": "string"
        }
       }
      }
     }
    }
   }
  },
  "/api/reputation/leaderboard": {
   "get": {
    "operationId": "reputationLeaderboard",
    "summary": "Top x402 services by reputation score across the public ecosystem",
    "responses": {
     "200": {
      "description": "Leaderboard",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    }
   }
  },
  "/api/verified/submissions/{id}": {
   "get": {
    "operationId": "verifiedSubmissionStatus",
    "summary": "Status of an x402 Verified submission by id",
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Status",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "404": {
      "description": "Unknown id"
     }
    }
   }
  }
 }
}